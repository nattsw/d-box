# copy to .env and tweak as needed (sourced by ./d-box)

# base image to build FROM and the resulting tag
DBOX_BASE=discourse/discourse_dev:release
DBOX_IMAGE=d-box:latest

# path to the main discourse working copy (provides the shared .git + worktrees)
DBOX_REPO=$HOME/work/discourse/discourse

# default base branch for `d-box new <branch>`
DBOX_BASE_BRANCH=main

# admin user auto-created on `new` — leave DBOX_ADMIN_PASSWORD empty to skip
DBOX_ADMIN_USERNAME=tomtom
DBOX_ADMIN_EMAIL=tomtom@example.com
DBOX_ADMIN_PASSWORD=

# optional: patch-triage MCP gem source (baked into the image if the dir exists)
DBOX_PATCH_TRIAGE_MCP=$HOME/work/discourse/patch-triage/mcp

# @discourse/mcp release to install globally. The default in d-box is pinned to
# the newest Node-22-compatible release; current 0.2.x releases require Node 24.
# DBOX_DISCOURSE_MCP=@discourse/mcp@0.1.10

# Playwright MCP version used by Claude/Codex browser tools inside boxes. The
# wrapper always launches it with d-box's baked Chromium.
# DBOX_PLAYWRIGHT_MCP=@playwright/mcp@0.0.75

# optional: enables the remote GitHub MCP inside Codex boxes. The launcher
# forwards it only to the Codex process; it is not stored in container metadata.
# GITHUB_PAT=

# files copied into every new box: list them in d-box/copy-files (see its comments).
# Override the manifest location here if you want:
# DBOX_COPY_MANIFEST=$HOME/some/other/copy-files

# tailnet exposure: every new box gets a `tailscale serve` proxy on its own port
# (reachable from your other tailnet devices). Set to 0 to disable.
DBOX_EXPOSE=1
DBOX_TS_BASE_PORT=3001
